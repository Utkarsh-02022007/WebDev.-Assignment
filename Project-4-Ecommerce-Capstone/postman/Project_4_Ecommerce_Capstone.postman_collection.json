      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login successful',()=>pm.response.to.have.status(200));",
              "const j=pm.response.json(); pm.expect(j.accessToken).to.be.a('string'); pm.expect(j.refreshToken).to.be.a('string');",
              "pm.collectionVariables.set('adminToken',j.accessToken);",
              "pm.collectionVariables.set('refreshToken',j.refreshToken);",
              "pm.collectionVariables.set('accessToken',j.accessToken);"
            ]
          }
